.env
node_modules/
.DS_Store
coverage/
.venv/
__pycache__/
.ipynb_checkpoints/
*.egg-info/
vendor/*
!vendor/README.md
.scratch/
infra/**/.terraform/
infra/**/*.tfstate*
infra/**/terraform.tfvars
infra/**/.terraform.lock.hcl
.pytest_cache/
docs/reference/ts-spikes/node_modules/
dataset/release/*/build/
dataset/release/*/hf/
.impeccable/review/

# publication staging data (generated; README, SOURCES, NOTICE and reports are committed)
dataset/publish/*/data/

# edition 2: never committed, the repository is public (dataset/goldrails_dataset/e2_local.py explains the layout).
# private/: the private slice and owner-only files (review packets, _lead answer keys, full disagreement notes).
# local/: text of rows whose source licence is not cleared in dataset/release/redistribution.json.
dataset/edition2/**/private/
# the private-slice salt (dataset/goldrails_dataset/e2_local.py): owner only, back it up with the private/ folders
dataset/edition2/.private-salt
# digests of upstream training splits for the model-training overlap check (goldrails_dataset.model_overlap)
dataset/edition2/.model-overlap-cache/
dataset/edition2/**/local/
dataset/edition2/**/_lead/
# content human second-label sample (ruling 7): label.html embeds row text, much of it harmful
dataset/edition2/content/sample/
# edition 2 build split files are rebuilt offline and byte-identically from the committed candidates
# (uv run python -m goldrails_dataset.edition2); manifest.json and audit-report.json are committed to check them
dataset/edition2/build/F*.jsonl
# edition 2 Hugging Face staging (goldrails_dataset.publish_e2): the whole folder, until the owner uploads it
dataset/publish/release-*/
dataset/publish/v2.*/
# edition 2 rows rebuilt for the runners from the Hub copy plus local text and the unpublished slice (goldrails_bench.e2_source)
dataset/edition2/.materialized/
# the prompt-attack suite in r26/ has the same layout; its local/ also holds the row recipes (upstream ids)
# result ledgers: the raw ledgers hold unpublished-slice ids; the run scripts write public-only copies beside them
benchmark/results/**/private/
benchmark/results/**/.run-log.lock
# the published results (leaderboard, README, plots, per-row ledgers and run logs) are held back until release day;
# benchmark/runs/e2_openai_run.py score rebuilds leaderboard.json from these ledgers
benchmark/results/final/
dataset/edition2/.frozen/

# site: the generated results data (site/scripts/build-data.ts) is held until release day; fixtures/data/ is committed

# Vercel CLI link (local only)
.vercel
