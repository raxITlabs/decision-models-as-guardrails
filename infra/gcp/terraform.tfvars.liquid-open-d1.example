# Liquid AI's open d1 models (benchmark/runs/e2_liquid_run.py), both on one L4 card in bf16 (g2-standard-8). The full
# run's VM models used g2-standard-24; no zone had that capacity on 29-30 October 2026, so the owner chose one card.
# Copy over terraform.tfvars (keep your own project_id and access settings) and apply with the VM stopped.
project_id    = "raxit-ai"
zone          = "us-east4-a"
machine_type  = "g2-standard-8"
spot          = false
max_run_hours = 4
models = [
  { name = "liquid-d1-2b", kind = "liquid", ref = "LiquidAI/d1-2B", revision = "cfe5760ff5d5998f91d9ac56bd4b2dbd96996d41", port = 8031, gpu = 0 },
  { name = "liquid-d1-3b", kind = "liquid", ref = "LiquidAI/d1-3B", revision = "051bcc464b01b9f92942b364d9586b0ef5912432", port = 8032, gpu = 0 },
]
attach_service_account = false
