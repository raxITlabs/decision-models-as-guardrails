{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "decision-models-as-guardrails.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://decision-models-as-guardrails.raxitlabs.com/$1" }
    },
    {
      "src": "/reproduce/?",
      "has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
      "dest": "/reproduce.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" }
    },
    { "src": "/(.*)\\.md", "headers": { "Content-Type": "text/markdown; charset=utf-8" }, "continue": true },
    { "src": "/llms\\.txt", "headers": { "Content-Type": "text/plain; charset=utf-8" }, "continue": true },
    { "src": "/opengraph-image", "headers": { "Content-Type": "image/png" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/data/rows/([^/]+)/?", "dest": "/data/rows/view" }
  ]
}
