{
  "name": "decision-models-as-guardrails-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/build-data.ts",
    "build": "next build",
    "prebuild": "tsx scripts/build-data.ts",
    "start": "pnpm dlx serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "data": "tsx scripts/build-data.ts",
    "data:fixture": "tsx scripts/make-fixture.ts && tsx scripts/build-data.ts --fixture"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.1.2"
}
